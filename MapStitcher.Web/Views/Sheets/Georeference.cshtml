@model MapStitcher.Model.GeoreferenceViewModel
@{
    ViewData["Title"] = "Georeference Sheet";
}

<h3>Georeference — Sheet @Model.SheetNumber</h3>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.TiePoints.Any())
{
    <p class="text-muted">No tie points found for this sheet. Parse the sheet first.</p>
}
else
{
    <form method="post" asp-controller="Sheets" asp-action="Georeference">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="SheetID" />
        <input type="hidden" asp-for="SheetNumber" />
        <input type="hidden" asp-for="ProjectID" />

        <table class="table table-bordered table-sm align-middle">
            <thead>
                <tr>
                    <th>Point Label</th>
                    <th>Source X</th>
                    <th>Source Y</th>
                    <th>Target X</th>
                    <th>Target Y</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.TiePoints.Count; i++)
                {
                    <tr>
                        <td>
                            <input type="hidden" asp-for="TiePoints[i].PointID" />
                            <input type="text" class="form-control form-control-sm"
                                   asp-for="TiePoints[i].PointLabel" placeholder="e.g. P1" />
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm" readonly
                                   value="@Model.TiePoints[i].SourceX.ToString("F3")" />
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm" readonly
                                   value="@Model.TiePoints[i].SourceY.ToString("F3")" />
                        </td>
                        <td>
                            <input type="number" step="any" class="form-control form-control-sm"
                                   asp-for="TiePoints[i].TargetX" placeholder="Target X" />
                        </td>
                        <td>
                            <input type="number" step="any" class="form-control form-control-sm"
                                   asp-for="TiePoints[i].TargetY" placeholder="Target Y" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary">Save Control Points</button>
        <a class="btn btn-secondary" asp-controller="Sheets" asp-action="Workspace" asp-route-projectId="@Model.ProjectID">Back to Workspace</a>
    </form>
}
