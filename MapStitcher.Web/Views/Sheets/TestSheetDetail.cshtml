@using MapStitcher.Database
@{
    var sheet = ViewBag.Sheet as SurveySheet;
    var tiePoints = ViewBag.TiePoints as List<TiePoint> ?? new List<TiePoint>();
    var boundaries = ViewBag.Boundaries as List<SheetBoundary> ?? new List<SheetBoundary>();
    int tpIdx = 0;
    int bIdx = 0;
    int vIdx = 0;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Test Sheet Detail</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: #0f172a;
            color: #e2e8f0;
            font-family: 'Segoe UI',sans-serif;
            padding: 20px;
        }

        .section {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .section-title {
            background: #0f172a;
            padding: 10px 16px;
            font-size: 13px;
            font-weight: 600;
            color: #94a3b8;
            border-bottom: 1px solid #334155;
            text-transform: uppercase;
            letter-spacing: .05em;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        th {
            background: #0f172a;
            color: #64748b;
            font-weight: 600;
            padding: 8px 14px;
            text-align: left;
            border-bottom: 1px solid #334155;
        }

        td {
            padding: 8px 14px;
            border-bottom: 1px solid #1e293b;
            color: #cbd5e1;
            font-family: monospace;
        }

        tr:hover td {
            background: #263044;
        }

        .meta-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(200px,1fr));
        }

        .meta-item {
            padding: 12px 16px;
            border-right: 1px solid #334155;
            border-bottom: 1px solid #334155;
        }

        .meta-label {
            font-size: 11px;
            color: #64748b;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .meta-value {
            font-size: 14px;
            color: #f1f5f9;
            font-family: monospace;
        }

        .empty-note {
            padding: 20px;
            color: #475569;
            font-size: 13px;
            text-align: center;
        }

        .poly-block {
            padding: 10px 16px;
            border-bottom: 1px solid #334155;
        }

        .poly-label {
            font-size: 12px;
            color: #64748b;
            margin-bottom: 6px;
        }
    </style>
</head>
<body>

    <h5 style="margin-bottom:20px;">Sheet Detail — Test Page</h5>

    <!-- SEARCH FORM -->
    <div class="section">
        <div class="section-title">Enter Sheet ID</div>
        <div style="padding:16px;">
            <form method="get" action="/Sheets/TestSheetDetail" style="display:flex;gap:10px;">
                <input type="number" name="sheetId" placeholder="Sheet ID"
                       class="form-control form-control-sm bg-dark text-light border-secondary"
                       style="width:160px;"
                       value="@(sheet?.SheetID.ToString() ?? "")" />
                <button type="submit" class="btn btn-sm btn-primary">Load</button>
            </form>
            @if (ViewBag.Error != null)
            {
                <div style="color:#ef4444; margin-top:10px; font-size:13px;">@ViewBag.Error</div>
            }
        </div>
    </div>

    @if (sheet != null)
    {
        <!-- META -->
        <div class="section">
            <div class="section-title">Sheet Info</div>
            <div class="meta-grid">
                <div class="meta-item">
                    <div class="meta-label">Sheet Number</div>
                    <div class="meta-value">@sheet.SheetNumber</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Laghu Reference Number</div>
                    <div class="meta-value">@(string.IsNullOrWhiteSpace(sheet.LaghuReferenceNumber) ? "—" : sheet.LaghuReferenceNumber)</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Status</div>
                    <div class="meta-value">@sheet.Status</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Has Geometry</div>
                    <div class="meta-value">@sheet.HasGeometry</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Boundary Is Rectangle</div>
                    <div class="meta-value">@sheet.BoundaryIsRectangle</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">DWG Version</div>
                    <div class="meta-value">@(sheet.DwgVersion ?? "—")</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Laghu Neighbor N/S/E/W</div>
                    <div class="meta-value">@(sheet.NeighborSheetNumberNorth ?? "—") / @(sheet.NeighborSheetNumberSouth ?? "—") / @(sheet.NeighborSheetNumberEast ?? "—") / @(sheet.NeighborSheetNumberWest ?? "—")</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Uploaded</div>
                    <div class="meta-value">@sheet.UploadedDate.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
            </div>
        </div>

        <!-- EXTENTS -->
        <div class="section">
            <div class="section-title">Bounding Box</div>
            <div class="meta-grid">
                <div class="meta-item"><div class="meta-label">Min X</div><div class="meta-value">@sheet.BoundsMinX.ToString("F4")</div></div>
                <div class="meta-item"><div class="meta-label">Min Y</div><div class="meta-value">@sheet.BoundsMinY.ToString("F4")</div></div>
                <div class="meta-item"><div class="meta-label">Max X</div><div class="meta-value">@sheet.BoundsMaxX.ToString("F4")</div></div>
                <div class="meta-item"><div class="meta-label">Max Y</div><div class="meta-value">@sheet.BoundsMaxY.ToString("F4")</div></div>
                <div class="meta-item"><div class="meta-label">Width</div><div class="meta-value">@((sheet.BoundsMaxX - sheet.BoundsMinX).ToString("F4"))</div></div>
                <div class="meta-item"><div class="meta-label">Height</div><div class="meta-value">@((sheet.BoundsMaxY - sheet.BoundsMinY).ToString("F4"))</div></div>
            </div>
        </div>

        <!-- TIE POINTS -->
        <div class="section">
            <div class="section-title">Tie Points — Insertion Points (X, Y) &nbsp;<span style="color:#475569;font-size:11px;text-transform:none;">@tiePoints.Count point(s)</span></div>
            @if (tiePoints.Count == 0)
            {
                <div class="empty-note">No tie points extracted for this sheet.</div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Label</th>
                            <th>Source X</th>
                            <th>Source Y</th>
                            <th>Target X</th>
                            <th>Target Y</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tp in tiePoints)
                        {
                            tpIdx++;
                            <tr>
                                <td>@tpIdx</td>
                                <td>@(tp.PointLabel ?? "—")</td>
                                <td>@tp.SourceX.ToString("F4")</td>
                                <td>@tp.SourceY.ToString("F4")</td>
                                <td>@(tp.TargetX.HasValue? tp.TargetX.Value.ToString("F4") : "—")</td>
                                <td>@(tp.TargetY.HasValue? tp.TargetY.Value.ToString("F4") : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- BOUNDARY POLYGONS -->
        <div class="section">
            <div class="section-title">Shape — Boundary Polygons &nbsp;<span style="color:#475569;font-size:11px;text-transform:none;">@boundaries.Count polygon(s)</span></div>
            @if (boundaries.Count == 0)
            {
                <div class="empty-note">No boundary polygons extracted for this sheet.</div>
            }
            else
            {
                foreach (var boundary in boundaries)
                {
                    bIdx++;
                    vIdx = 0;
                    <div class="poly-block">
                        <div class="poly-label">
                            Polygon @bIdx &nbsp;|&nbsp; @boundary.Geometry.Coordinates.Length vertex(es)
                            @if (!string.IsNullOrWhiteSpace(boundary.PlotLabel))
                            {
                                <span style="color:#94a3b8">&nbsp;|&nbsp; Label: @boundary.PlotLabel</span>
                            }
                        </div>
                        <table>
                            <thead>
                                <tr>
                                    <th>Vertex</th>
                                    <th>X</th>
                                    <th>Y</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var coord in boundary.Geometry.Coordinates)
                                {
                                    vIdx++;
                                    <tr>
                                        <td>@vIdx</td>
                                        <td>@coord.X.ToString("F4")</td>
                                        <td>@coord.Y.ToString("F4")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>