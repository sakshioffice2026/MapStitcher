@model MapStitcher.Model.WorkspaceViewModel

@{
    ViewData["Title"] = "CAD Sheet Workspace";
    Layout = null;

    var statusColor = new Dictionary<string, string>
    {
        ["Uploaded"] = "#94a3b8",
        ["Parsed"] = "#3b82f6",
        ["Georeferenced"] = "#f59e0b",
        ["Merged"] = "#22c55e",
        ["Failed"] = "#ef4444"
    };

    int gridRows = Math.Max(Model.GridRows, 3);
    int gridCols = Math.Max(Model.GridCols, 3);
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        CAD Workspace — @Model.Village
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="~/css/workspace.css"
          rel="stylesheet" />
</head>

<body>

    <!-- =========================================================
         TOP BAR
         ========================================================= -->

    <div class="top-bar">

        <div class="project-heading">

            <div class="project-name">
                @Model.ProjectName
            </div>

            <div class="jurisdiction">
                <span>@Model.District</span>
                <span class="separator">›</span>
                <span>@Model.Taluka</span>
                <span class="separator">›</span>
                <span>@Model.Village</span>
            </div>

        </div>


        <div class="top-actions">

            <button type="button"
                    class="btn btn-sm btn-primary"
                    onclick="stitchAll()">
                ⚡ Stitch Available Sheets
            </button>

            <button type="button"
                    class="btn btn-sm btn-warning"
                    onclick="mergeSheets()">
                🧩 Merge Sheets
            </button>

            <a href="@Url.Action("Upload", "Sheets", new { projectId = Model.ProjectID })"
               class="btn btn-sm btn-outline-info">
                + Upload Sheet
            </a>

            <a href="@Url.Action("Export", "Sheets", new { projectId = Model.ProjectID })"
               class="btn btn-sm btn-outline-success">
                ↓ Export DXF
            </a>

            <a href="@Url.Action("Index", "Projects")"
               class="btn btn-sm btn-outline-secondary">
                ← Projects
            </a>

        </div>

    </div>


    <!-- =========================================================
         ALERTS
         ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-bar">

            <div class="alert alert-success alert-dismissible mb-0 py-2"
                 role="alert">

                @TempData["Success"]

                <button type="button"
                        class="btn-close btn-sm"
                        data-bs-dismiss="alert">
                </button>

            </div>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert-bar">

            <div class="alert alert-danger alert-dismissible mb-0 py-2"
                 role="alert">

                @TempData["Error"]

                <button type="button"
                        class="btn-close btn-sm"
                        data-bs-dismiss="alert">
                </button>

            </div>

        </div>
    }


    <!-- =========================================================
         MAIN WORKSPACE
         ========================================================= -->

    <div class="workspace-layout">


        <!-- =====================================================
             LEFT SHEET SIDEBAR
             ===================================================== -->

        <aside class="sidebar">

            <div class="sidebar-header">
                Sheets (@Model.Sheets.Count)
            </div>


            <div class="sidebar-sheet-list">

                @foreach (var sheet in Model.Sheets.OrderBy(s => s.SheetNumber))
                {
                    bool isPlaced =
                    sheet.GridRow.HasValue &&
                    sheet.GridCol.HasValue;

                    string statusCol =
                    statusColor.GetValueOrDefault(
                    sheet.Status.ToString(),
                    "#94a3b8");

                    <div class="sidebar-sheet @(isPlaced ? "placed" : "unplaced")"
                         onclick="selectSheet(@sheet.SheetID)"
                         draggable="true"
                         ondragstart="dragStart(event, @sheet.SheetID)"
                         data-sheet-id="@sheet.SheetID"
                         data-sheet-num="@sheet.SheetNumber"
                         data-status="@sheet.Status"
                         data-row="@(sheet.GridRow?.ToString() ?? "")"
                         data-col="@(sheet.GridCol?.ToString() ?? "")">

                        <button type="button"
                                class="sidebar-remove-btn"
                                title="Remove sheet"
                                onclick="event.stopPropagation(); removeSheet(@sheet.SheetID, '@sheet.SheetNumber')">
                            ✕
                        </button>

                        <div class="sheet-num">
                            Sheet @sheet.SheetNumber
                        </div>

                        <div class="sheet-status"
                             style="color:@statusCol">

                            ● @sheet.Status

                            @if (isPlaced)
                            {
                                <span>
                                    (@sheet.GridRow,@sheet.GridCol)
                                </span>
                            }
                            else
                            {
                                <span>
                                    (unplaced)
                                </span>
                            }

                        </div>

                    </div>
                }

            </div>


            <div class="sidebar-upload">

                <a href="@Url.Action("Upload", "Sheets", new { projectId = Model.ProjectID })"
                   class="btn btn-sm btn-outline-info w-100">
                    + Upload Sheet
                </a>

            </div>

        </aside>


        <!-- =====================================================
             CENTER AREA
             ===================================================== -->

        <main class="canvas-area">


            <!-- =================================================
                 VIEW TOOLBAR
                 ================================================= -->

            <div class="canvas-toolbar">

                <div class="view-toggle">

                    <button id="btn-cad"
                            class="active"
                            onclick="switchView('cad')">
                        CAD Geometry
                    </button>

                    <button id="btn-grid"
                            onclick="switchView('grid')">
                        Placement Grid
                    </button>

                </div>


                <div class="toolbar-info"
                     id="toolbar-info">

                    @Model.Sheets.Count(s => s.GridRow.HasValue)
                    /
                    @Model.Sheets.Count
                    placed

                </div>

            </div>


            <!-- =================================================
                 CONTENT SCROLL AREA
                 ================================================= -->

            <div class="canvas-scroll">


                <!-- =============================================
                     TRUE CAD GEOMETRY VIEW
                     ============================================= -->

                <div id="cad-view"
                     class="cad-view">

                    <div class="cad-toolbar">

                        <div class="cad-toolbar-title">

                            <strong>
                                DWG / DXF Geometry
                            </strong>

                            <span>
                                Actual sheet boundary geometry
                            </span>

                        </div>


                        <div class="cad-toolbar-actions">

                            <button type="button"
                                    onclick="cadZoomOut()"
                                    title="Zoom out">
                                −
                            </button>

                            <button type="button"
                                    onclick="cadZoomReset()"
                                    title="Reset zoom">
                                100%
                            </button>

                            <button type="button"
                                    onclick="cadZoomIn()"
                                    title="Zoom in">
                                +
                            </button>

                            <button type="button"
                                    onclick="cadFitToGeometry()"
                                    title="Fit geometry">
                                Fit
                            </button>

                        </div>

                    </div>


                    <div id="cad-geometry-container"
                         class="cad-geometry-container">

                        <div id="cad-geometry-loading"
                             class="cad-geometry-loading">

                            Loading CAD geometry...

                        </div>


                        <div id="cad-geometry-content"
                             class="cad-geometry-content">
                        </div>


                        <div id="cad-geometry-empty"
                             class="cad-geometry-empty"
                             style="display:none;">

                            No CAD boundary geometry is available.

                        </div>

                    </div>

                </div>


                <!-- =============================================
                     PLACEMENT GRID
                     ============================================= -->

                <div id="grid-view"
                     style="
                        --grid-cols:@gridCols;
                        --grid-rows:@gridRows;
                        display:none;
                     ">

                    @for (int r = 0; r < gridRows; r++)
                    {
                        @for (int c = 0; c < gridCols; c++)
                        {
                            var sheet =
                            Model.GetSheetAt(r, c);

                            if (sheet != null)
                            {
                                string statusCol =
                                statusColor.GetValueOrDefault(
                                sheet.Status.ToString(),
                                "#94a3b8");

                                <div class="grid-cell filled"
                                     id="cell-@r-@c"
                                     data-row="@r"
                                     data-col="@c"
                                     data-sheet-id="@sheet.SheetID"
                                     draggable="true"
                                     ondragstart="dragStart(event, @sheet.SheetID)"
                                     onclick="selectSheet(@sheet.SheetID)"
                                     title="Sheet @sheet.SheetNumber">

                                    <div class="cell-coord">
                                        @r,@c
                                    </div>

                                    <div class="cell-label">
                                        @sheet.SheetNumber
                                    </div>

                                    <div class="cell-status-dot"
                                         style="background:@statusCol">
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(sheet.FailureReason))
                                    {
                                        <div class="cell-warning-badge"
                                             title="@sheet.FailureReason">

                                            ⚠ @sheet.FailureReason

                                        </div>
                                    }

                                </div>
                            }
                            else
                            {
                                <div class="grid-cell empty"
                                     id="cell-@r-@c"
                                     data-row="@r"
                                     data-col="@c"
                                     onclick="promptManualPlace(@r, @c)"
                                     title="Empty — drop sheet here">

                                    <div class="cell-coord">
                                        @r,@c
                                    </div>

                                    <div class="empty-plus">
                                        +
                                    </div>

                                    <div class="empty-label">
                                        Drop or click
                                    </div>

                                </div>
                            }
                        }
                    }

                </div>

            </div>

        </main>


        <!-- =====================================================
             RIGHT DETAIL PANEL
             ===================================================== -->

        <aside class="detail-panel">

            <div class="detail-header">
                Sheet Details
            </div>


            <div class="detail-body"
                 id="detail-body">

                <div class="detail-empty">
                    Select a sheet to view details.
                </div>

            </div>


            <div class="merge-suggestions"
                 id="merge-suggestions">
            </div>


            <div class="detail-actions"
                 id="detail-actions"
                 style="display:none">

                <a id="btn-georeference"
                   href="#"
                   class="btn btn-sm btn-outline-warning">
                    Georeference
                </a>


                <form method="post"
                      id="form-parse">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="sheetId"
                           id="parse-sheet-id" />

                    <button type="submit"
                            formaction="@Url.Action("Parse", "Sheets")"
                            class="btn btn-sm btn-outline-info w-100">

                        Re-Parse

                    </button>

                </form>


                <button type="button"
                        class="btn btn-sm btn-outline-danger w-100"
                        onclick="removeSelectedSheet()">

                    Remove Sheet

                </button>

            </div>


            <!-- =================================================
                 LEGEND
                 ================================================= -->

            <div class="legend">

                <div class="legend-title">
                    Status
                </div>

                <div class="legend-item">
                    <div class="legend-dot"
                         style="background:#94a3b8">
                    </div>
                    Uploaded
                </div>

                <div class="legend-item">
                    <div class="legend-dot"
                         style="background:#3b82f6">
                    </div>
                    Parsed
                </div>

                <div class="legend-item">
                    <div class="legend-dot"
                         style="background:#f59e0b">
                    </div>
                    Georeferenced
                </div>

                <div class="legend-item">
                    <div class="legend-dot"
                         style="background:#22c55e">
                    </div>
                    Merged
                </div>

                <div class="legend-item">
                    <div class="legend-dot"
                         style="background:#ef4444">
                    </div>
                    Failed
                </div>

            </div>

        </aside>

    </div>


    <!-- =========================================================
         MANUAL PLACE MODAL
         ========================================================= -->

    <div class="modal fade"
         id="manualPlaceModal"
         tabindex="-1">

        <div class="modal-dialog modal-sm">

            <div class="modal-content bg-dark text-light border-secondary">

                <div class="modal-header border-secondary py-2">

                    <h6 class="modal-title">
                        Place Sheet Manually
                    </h6>

                    <button type="button"
                            class="btn-close btn-close-white btn-sm"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <p class="text-secondary"
                       style="font-size:12px">

                        Target cell:

                        <strong id="target-cell-label">
                        </strong>

                    </p>


                    <form method="post"
                          action="@Url.Action("PlaceSheet", "Sheets")">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="gridRow"
                               id="manual-row" />

                        <input type="hidden"
                               name="gridCol"
                               id="manual-col" />


                        <div class="mb-2">

                            <label class="form-label"
                                   style="font-size:12px">

                                Select Sheet

                            </label>


                            <select name="sheetId"
                                    id="manual-sheet-select"
                                    class="form-select form-select-sm bg-dark text-light border-secondary">

                                @foreach (var s in Model.UnplacedSheets)
                                {
                                    <option value="@s.SheetID">
                                        Sheet @s.SheetNumber (@s.Status)
                                    </option>
                                }

                            </select>

                        </div>


                        <button type="submit"
                                class="btn btn-sm btn-primary w-100">

                            Place Here

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         REMOVE SHEET FORM
         ========================================================= -->

    <form method="post"
          id="form-remove"
          action="@Url.Action("RemoveSheet", "Sheets")">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="sheetId"
               id="remove-sheet-id" />

    </form>


    <!-- =========================================================
         MERGE FORM
         ========================================================= -->

    <form method="post"
          id="form-merge"
          action="@Url.Action("Merge", "Sheets")">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="baseSheetId"
               id="merge-base-id" />

        <input type="hidden"
               name="adjacentSheetId"
               id="merge-adjacent-id" />

    </form>


    <!-- =========================================================
         STITCH ALL FORM
         ========================================================= -->

    <form method="post"
          id="form-stitch-all"
          action="@Url.Action("StitchAll", "Sheets")">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="projectId"
               value="@Model.ProjectID" />

    </form>


    <!-- =========================================================
         MERGE SHEETS FORM (jigsaw full-entity DXF export)
         ========================================================= -->

    <form method="post"
          id="form-merge-sheets"
          action="@Url.Action("MergeSheets", "Sheets")">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="projectId"
               value="@Model.ProjectID" />

        <input type="hidden"
               name="columnsPerRow"
               id="merge-sheets-columns-per-row" />

    </form>


    <!-- =========================================================
         BOOTSTRAP
         ========================================================= -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- =========================================================
         WORKSPACE CONFIG
         ========================================================= -->

    <script>

        window.workspaceConfig = {

            sheets:
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                            Model.Sheets.Select(s => new
                            {
                                    s.SheetID,
                                    s.SheetNumber,
                                    Status = s.Status.ToString(),
                                    GridRow = s.GridRow,
                                    GridCol = s.GridCol
                            })
                    )
                                ),

            unplacedCount:
                @Model.UnplacedSheets.Count,

            urls: {

                georeference:
                    '@Url.Action("Georeference", "Sheets")',

                getOpenSlots:
                    '@Url.Action("GetOpenSlots", "Sheets")',

                placeSheet:
                    '@Url.Action("PlaceSheet", "Sheets")',

                svgPreview:
                    '@Url.Action("SvgPreview", "Sheets", new { projectId = Model.ProjectID })'
            }

        };

    </script>


    <script src="~/js/workspace.js"></script>

</body>
</html>