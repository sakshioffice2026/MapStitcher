@model MapStitcher.Model.WorkspaceViewModel
@{
    ViewData["Title"] = "Jigsaw Board";
    Layout = null;

    var statusColor = new Dictionary<string, string>
    {
        ["Uploaded"]     = "#94a3b8",
        ["Parsed"]       = "#3b82f6",
        ["Georeferenced"]= "#f59e0b",
        ["Merged"]       = "#22c55e",
        ["Failed"]       = "#ef4444"
    };

    int gridRows = Math.Max(Model.GridRows, 3);
    int gridCols = Math.Max(Model.GridCols, 3);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Jigsaw Board — @Model.Village</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/workspace.css" rel="stylesheet" />
</head>
<body>

    @* ── Top Bar ── *@
    <div class="top-bar">
        <div>
            <div style="font-weight:600; font-size:15px;">@Model.ProjectName</div>
            <div class="jurisdiction">
                <span>@Model.District</span> &rsaquo;
                <span>@Model.Taluka</span> &rsaquo;
                <span>@Model.Village</span>
            </div>
        </div>
        <div class="actions">
            <button type="button" class="btn btn-sm btn-primary" onclick="stitchAll()">⚡ Stitch Available Sheets</button>
            <a href="@Url.Action("Upload","Sheets", new { projectId = Model.ProjectID })"
               class="btn btn-sm btn-outline-info">+ Upload Sheet</a>
               <a href="@Url.Action("Export","Sheets", new { projectId = Model.ProjectID })"
                class="btn btn-sm btn-outline-success">⬇ Export DXF</a>
            <a href="@Url.Action("Index","Projects")"
               class="btn btn-sm btn-outline-secondary">← Projects</a>

        </div>
    </div>

    @* ── Alerts ── *@
    @if (TempData["Success"] != null)
    {
        <div class="alert-bar">
            <div class="alert alert-success alert-dismissible mb-0 py-2" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-bar">
            <div class="alert alert-danger alert-dismissible mb-0 py-2" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    @* ── Main Layout ── *@
    <div class="workspace-layout">

        @* ── Left Sidebar ── *@
        <div class="sidebar">
            <div class="sidebar-header">Sheets (@Model.Sheets.Count)</div>

            @foreach (var sheet in Model.Sheets.OrderBy(s => s.SheetNumber))
            {
                bool isPlaced = sheet.GridRow.HasValue && sheet.GridCol.HasValue;
                string statusCol = statusColor.GetValueOrDefault(sheet.Status.ToString(), "#94a3b8");

                <div class="sidebar-sheet @(isPlaced ? "placed" : "unplaced")"
                     onclick="selectSheet(@sheet.SheetID)"
                     draggable="true"
                     ondragstart="dragStart(event, @sheet.SheetID)"
                     data-sheet-id="@sheet.SheetID"
                     data-sheet-num="@sheet.SheetNumber"
                     data-laghu="@(sheet.LaghuReferenceNumber ?? "—")"
                     data-status="@sheet.Status"
                     data-row="@(sheet.GridRow?.ToString() ?? "")"
                     data-col="@(sheet.GridCol?.ToString() ?? "")">
                    <button type="button" class="sidebar-remove-btn" title="Remove sheet"
                            onclick="event.stopPropagation(); removeSheet(@sheet.SheetID, '@sheet.SheetNumber')">✕</button>
                    <div class="sheet-num">Sheet @sheet.SheetNumber</div>
                    <div class="sheet-status" style="color:@statusCol">
                        ● @sheet.Status @(isPlaced ? $"({sheet.GridRow},{sheet.GridCol})" : "(unplaced)")
                    </div>
                </div>
            }

            <div class="sidebar-upload">
                <a href="@Url.Action("Upload","Sheets", new { projectId = Model.ProjectID })"
                   class="btn btn-sm btn-outline-info w-100">+ Upload Sheet</a>
            </div>
        </div>

        @* ── Center Canvas ── *@
        <div class="canvas-area">
            <div class="canvas-toolbar">
                <div class="view-toggle">
                    <button id="btn-grid" class="active" onclick="switchView('grid')">Grid View</button>
                    <button id="btn-canvas" onclick="switchView('canvas')">Canvas View</button>
                </div>
                <span id="toolbar-info" style="margin-left:auto;">
                    @Model.Sheets.Count(s => s.GridRow.HasValue) / @Model.Sheets.Count placed
                </span>
            </div>

            <div class="canvas-scroll">

                @* ── Level 1: Grid View ── *@
                <div id="grid-view" style="--grid-cols:@gridCols; --grid-rows:@gridRows;">
                    @for (int r = 0; r < gridRows; r++)
                    {
                        @for (int c = 0; c < gridCols; c++)
                        {
                            var sheet = Model.GetSheetAt(r, c);
                            if (sheet != null)
                            {
                                string statusCol = statusColor.GetValueOrDefault(sheet.Status.ToString(), "#94a3b8");
                                <div class="grid-cell filled"
                                     id="cell-@r-@c"
                                     data-row="@r" data-col="@c"
                                     data-sheet-id="@sheet.SheetID"
                                     data-laghu="@(sheet.LaghuReferenceNumber ?? "—")"
                                     draggable="true"
                                     ondragstart="dragStart(event, @sheet.SheetID)"
                                     onclick="selectSheet(@sheet.SheetID)"
                                     title="Sheet @sheet.SheetNumber">
                                    <div class="cell-coord">@r,@c</div>
                                    <div class="cell-label">@sheet.SheetNumber</div>
                                    <div class="cell-ref">@(sheet.LaghuReferenceNumber ?? "—")</div>
                                    <div class="cell-status-dot" style="background:@statusCol"></div>
                                    @if (!string.IsNullOrWhiteSpace(sheet.FailureReason))
                                    {
                                        <div class="cell-warning-badge" title="@sheet.FailureReason">⚠ @sheet.FailureReason</div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="grid-cell empty"
                                     id="cell-@r-@c"
                                     data-row="@r" data-col="@c"
                                     onclick="promptManualPlace(@r, @c)"
                                     title="Empty — drop sheet here">
                                    <div class="cell-coord">@r,@c</div>
                                    <div style="font-size:22px; color:#334155;">+</div>
                                    <div style="font-size:10px; margin-top:4px;">Drop or click</div>
                                </div>
                            }
                        }
                    }
                </div>

                @* ── Level 2: Canvas View ── *@
                <div id="canvas-view">
                    <svg id="canvas-svg">
                        @foreach (var sheet in Model.Sheets.Where(s => s.GridRow.HasValue && s.GridCol.HasValue))
                        {
                            double svgX = 40 + sheet.GridCol!.Value * 190.0;
                            double svgY = 40 + sheet.GridRow!.Value * 145.0;
                            double w = 170;
                            double h = 125;

                            string statusCol = statusColor.GetValueOrDefault(sheet.Status.ToString(), "#94a3b8");

                            <g class="sheet-polygon" id="poly-@sheet.SheetID"
                               data-sheet-id="@sheet.SheetID"
                               data-row="@sheet.GridRow" data-col="@sheet.GridCol"
                               data-laghu="@(sheet.LaghuReferenceNumber ?? "—")"
                               onmousedown="svgDragStart(event, @sheet.SheetID)"
                               onclick="selectSheet(@sheet.SheetID)" style="cursor:grab">
                                <rect x="@svgX" y="@svgY" width="@w" height="@h"
                                      rx="4" ry="4"
                                      fill="#1e3a5f" stroke="@statusCol" stroke-width="2"
                                      opacity="0.85" />
                                <text x="@(svgX + w/2)" y="@(svgY + h/2 - 8)"
                                      text-anchor="middle" fill="#38bdf8"
                                      font-size="13" font-weight="bold">@sheet.SheetNumber</text>
                                <text x="@(svgX + w/2)" y="@(svgY + h/2 + 10)"
                                      text-anchor="middle" fill="#94a3b8"
                                      font-size="10">@(sheet.LaghuReferenceNumber ?? "—")</text>
                                <circle cx="@(svgX + w - 12)" cy="@(svgY + 12)"
                                        r="5" fill="@statusCol" />
                            </g>
                        }
                        <rect id="ghost-slot" x="0" y="0" width="170" height="125" rx="4" ry="4"
                              fill="none" stroke-width="2" stroke-dasharray="6 4" style="display:none; pointer-events:none;" />
                    </svg>
                </div>

            </div>
        </div>

        @* ── Right Detail Panel ── *@
        <div class="detail-panel">
            <div class="detail-header">Sheet Details</div>
            <div class="detail-body" id="detail-body">
                <div class="detail-empty">Select a sheet to view details.</div>
            </div>

            <div class="merge-suggestions" id="merge-suggestions"></div>

            <div class="detail-actions" id="detail-actions" style="display:none">
                <a id="btn-georeference" href="#" class="btn btn-sm btn-outline-warning">Georeference</a>
                <form method="post" id="form-parse">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="sheetId" id="parse-sheet-id" />
                    <button type="submit"
                            formaction="@Url.Action("Parse","Sheets")"
                            class="btn btn-sm btn-outline-info w-100">Re-Parse</button>
                </form>
                <button type="button" class="btn btn-sm btn-outline-danger w-100" id="btn-remove-detail"
                        onclick="removeSelectedSheet()">Remove Sheet</button>
            </div>

            @* Legend *@
            <div class="legend">
                <div class="legend-title">Legend</div>
                <div class="legend-item"><div class="legend-dot" style="background:#94a3b8"></div>Uploaded</div>
                <div class="legend-item"><div class="legend-dot" style="background:#3b82f6"></div>Parsed</div>
                <div class="legend-item"><div class="legend-dot" style="background:#f59e0b"></div>Georeferenced</div>
                <div class="legend-item"><div class="legend-dot" style="background:#22c55e"></div>Merged</div>
                <div class="legend-item"><div class="legend-dot" style="background:#ef4444"></div>Failed</div>
            </div>
        </div>

    </div>

    @* ── Manual Place Modal ── *@
    <div class="modal fade" id="manualPlaceModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content bg-dark text-light border-secondary">
                <div class="modal-header border-secondary py-2">
                    <h6 class="modal-title">Place Sheet Manually</h6>
                    <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary" style="font-size:12px">
                        Target cell: <strong id="target-cell-label"></strong>
                    </p>
                    <form method="post" action="@Url.Action("PlaceSheet","Sheets")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="sheetId"  id="manual-sheet-id" />
                        <input type="hidden" name="gridRow"  id="manual-row" />
                        <input type="hidden" name="gridCol"  id="manual-col" />
                        <div class="mb-2">
                            <label class="form-label" style="font-size:12px">Select Sheet</label>
                            <select name="sheetId" id="manual-sheet-select" class="form-select form-select-sm bg-dark text-light border-secondary">
                                @foreach (var s in Model.UnplacedSheets)
                                {
                                    <option value="@s.SheetID">Sheet @s.SheetNumber (@s.Status)</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary w-100">Place Here</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* ── Remove Sheet Form (hidden, submitted via JS) ── *@
    <form method="post" id="form-remove" action="@Url.Action("RemoveSheet","Sheets")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="sheetId" id="remove-sheet-id" />
    </form>

    @* ── Merge Form (hidden, submitted via JS) ── *@
    <form method="post" id="form-merge" action="@Url.Action("Merge","Sheets")">
        <input type="hidden" name="baseSheetId" id="merge-base-id" />
        <input type="hidden" name="adjacentSheetId" id="merge-adjacent-id" />
    </form>

    @* ── Stitch All Form (hidden, submitted via JS) ── *@
    <form method="post" id="form-stitch-all" action="@Url.Action("StitchAll","Sheets")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="projectId" value="@Model.ProjectID" />
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.workspaceConfig = {
            sheets: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.Sheets.Select(s => new {
                    s.SheetID,
                    s.SheetNumber,
                    LaghuRef = s.LaghuReferenceNumber ?? "—",
                    Status   = s.Status.ToString(),
                    GridRow  = s.GridRow,
                    GridCol  = s.GridCol
                })
            )),
            unplacedCount: @Model.UnplacedSheets.Count,
            urls: {
                georeference: '@Url.Action("Georeference","Sheets")',
                getOpenSlots: '@Url.Action("GetOpenSlots","Sheets")',
                placeSheet: '@Url.Action("PlaceSheet","Sheets")'
            }
        };
    </script>
    <script src="~/js/workspace.js"></script>
</body>
</html>