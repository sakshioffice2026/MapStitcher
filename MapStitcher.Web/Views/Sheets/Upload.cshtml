@* Views/Sheets/Upload.cshtml — full file *@
@{
    ViewData["Title"] = "Upload Sheets";
    var projectId = ViewBag.ProjectID;
}

<h3>Upload Survey Sheets</h3>
<p class="text-muted" style="font-size:13px">
    Select one or more DWG/DXF files. Sheet numbers and Laghu references are detected automatically.
    Duplicate files (by content) are skipped.
</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form method="post" enctype="multipart/form-data" asp-controller="Sheets" asp-action="Upload" asp-route-projectId="@projectId">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">DWG / DXF Files</label>
        <input type="file" name="files" class="form-control" accept=".dwg,.dxf" multiple required />
        <span class="text-danger">@Html.ValidationMessage("files")</span>
    </div>

    <button type="submit" class="btn btn-primary">Upload All</button>
    <a class="btn btn-secondary" asp-controller="Sheets" asp-action="Workspace" asp-route-projectId="@projectId">Cancel</a>
</form>