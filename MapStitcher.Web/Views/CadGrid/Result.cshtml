
@model MapStitcher.Model.CadSheetGridResult

@{
    ViewData["Title"] = "CAD Sheet Grid";

    var sheetsByPosition = Model.Sheets
        .GroupBy(x => (x.Row, x.Column))
        .ToDictionary(g => g.Key, g => g.First());

    var missingByPosition = Model.MissingSlots
        .GroupBy(x => (x.Row, x.Column))
        .ToDictionary(g => g.Key, g => g.First());

    var duplicatePositions = Model.Sheets
        .GroupBy(x => (x.Row, x.Column))
        .Where(g => g.Count() > 1)
        .ToList();
}

<style>
    .cad-grid-page {
        padding: 24px;
    }

    .cad-grid-header {
        margin-bottom: 24px;
    }

        .cad-grid-header h1 {
            margin: 0 0 6px 0;
            font-size: 28px;
        }

        .cad-grid-header p {
            margin: 0;
            color: #666;
        }

    .summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(150px, 1fr));
        gap: 12px;
        margin-bottom: 30px;
    }

    .summary-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 16px;
        background: #fff;
    }

        .summary-card .label {
            display: block;
            font-size: 13px;
            color: #777;
            margin-bottom: 6px;
        }

        .summary-card .value {
            font-size: 24px;
            font-weight: 600;
        }

    .grid-section {
        margin-top: 20px;
    }

        .grid-section h2 {
            margin-bottom: 6px;
        }

    .grid-section-description {
        color: #666;
        margin-bottom: 16px;
    }

    .spatial-grid-wrapper {
        width: 100%;
        overflow-x: auto;
        padding-bottom: 10px;
    }

    .spatial-grid {
        display: grid;
        grid-template-columns: repeat( @Model.ColumnCount, minmax(250px, 1fr));
        gap: 12px;
        min-width: max-content;
    }

    .sheet {
        min-height: 180px;
        border: 1px solid #ccc;
        border-radius: 8px;
        background: #fff;
        padding: 16px;
        box-sizing: border-box;
    }

    .sheet-index {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .sheet-name {
        font-weight: 600;
        margin-bottom: 10px;
        word-break: break-word;
    }

    .sheet-number {
        font-size: 14px;
        margin-bottom: 8px;
    }

    .sheet-position {
        font-size: 13px;
        color: #555;
        margin-bottom: 8px;
    }

    .sheet-cad {
        font-size: 12px;
        color: #666;
        line-height: 1.5;
        margin-top: 10px;
    }

    .grid-empty {
        min-height: 180px;
        border: 2px dashed #bbb;
        border-radius: 8px;
        background: #fafafa;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        color: #999;
        box-sizing: border-box;
    }

    .grid-empty-title {
        font-size: 15px;
        font-weight: 600;
    }

    .grid-empty-position {
        margin-top: 5px;
        font-size: 11px;
        color: #aaa;
    }

    .grid-missing {
        border-color: #e0a800;
        background: #fff8e6;
        color: #8a6500;
    }

    .errors-section,
    .skipped-section {
        margin-top: 30px;
        padding: 16px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background: #fff;
    }

        .errors-section h2,
        .skipped-section h2 {
            margin-top: 0;
            font-size: 18px;
        }

        .errors-section ul,
        .skipped-section ul {
            margin-bottom: 0;
            padding-left: 20px;
        }

    .error-item {
        margin-bottom: 6px;
    }

    .skipped-item {
        margin-bottom: 6px;
    }

    .back-link {
        display: inline-block;
        margin-top: 24px;
        text-decoration: none;
    }

    @@media (max-width: 700px) {
        .cad-grid-page

    {
        padding: 16px;
    }

    .summary {
        grid-template-columns: 1fr;
    }

    .spatial-grid {
        grid-template-columns: repeat( @Model.ColumnCount, minmax(220px, 220px));
    }

    }</style>

<div class="cad-grid-page">

    <div class="cad-grid-header">
        <h1>CAD Sheet Grid</h1>
        <p>Spatial arrangement of uploaded CAD sheets.</p>
    </div>

    <div class="summary">

        <div class="summary-card">
            <span class="label">Sheets</span>
            <span class="value">@Model.SheetCount</span>
        </div>

        <div class="summary-card">
            <span class="label">Rows</span>
            <span class="value">@Model.RowCount</span>
        </div>

        <div class="summary-card">
            <span class="label">Columns</span>
            <span class="value">@Model.ColumnCount</span>
        </div>

    </div>

    <section class="grid-section">

        <h2>Index Grid</h2>

        <div class="grid-section-description">
            Each sheet is positioned according to its validated
            North, South, East and West relationships.
        </div>

        <div class="spatial-grid-wrapper">

            <div class="spatial-grid">

                @for (var row = 0; row < Model.RowCount; row++)
                {
                    @for (var column = 0; column < Model.ColumnCount; column++)
                    {
                        if (sheetsByPosition.TryGetValue(
                        (row, column),
                        out var sheet))
                        {
                            <div class="sheet">

                                <div class="sheet-index">
                                    Sheet #@sheet.IndexNumber
                                </div>

                                <div class="sheet-name">
                                    @sheet.FileName
                                </div>

                                <div class="sheet-number">
                                    Sheet Number:
                                    <strong>@sheet.SheetNumber</strong>
                                </div>

                                <div class="sheet-position">
                                    Row: @sheet.Row
                                    <br />
                                    Column: @sheet.Column
                                </div>

                                <div class="sheet-cad">
                                    <strong>CAD Bounds</strong>
                                    <br />
                                    X:
                                    @sheet.MinX.ToString("F2")
                                    –
                                    @sheet.MaxX.ToString("F2")
                                    <br />
                                    Y:
                                    @sheet.MinY.ToString("F2")
                                    –
                                    @sheet.MaxY.ToString("F2")
                                    <br />
                                    Width:
                                    @sheet.Width.ToString("F2")
                                    <br />
                                    Height:
                                    @sheet.Height.ToString("F2")
                                    <br />
                                    Entities:
                                    @sheet.EntityCount
                                    <br />
                                    Laghu References:
                                    @sheet.LaghuReferenceCount
                                </div>

                            </div>
                        }
                        else if (missingByPosition.TryGetValue(
                        (row, column),
                        out var missing))
                        {
                            <div class="grid-empty grid-missing">

                                <div class="grid-empty-title">
                                    Missing
                                </div>

                                <div class="grid-empty-position">
                                    Sheet @missing.SheetNumber not uploaded
                                    <br />
                                    Row @row · Column @column
                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="grid-empty">

                                <div class="grid-empty-title">
                                    Empty
                                </div>

                                <div class="grid-empty-position">
                                    Row @row · Column @column
                                </div>

                            </div>
                        }
                    }
                }

            </div>

        </div>

    </section>

    @if (!string.IsNullOrWhiteSpace(Model.MergeOutputFileName))
    {
        <section class="errors-section">
            <h2>Merged Output</h2>
            <a asp-controller="CadGrid"
               asp-action="DownloadMerged"
               asp-route-fileName="@Model.MergeOutputFileName">
                ⬇ Download stitched master DXF
            </a>
        </section>
    }

    @if ((Model.MergeErrors != null && Model.MergeErrors.Count > 0) ||
        duplicatePositions.Count > 0)
    {
        <section class="errors-section">

            <h2>Topology / Processing Messages</h2>

            <ul>
                @if (Model.MergeErrors != null)
                {
                    @foreach (var error in Model.MergeErrors)
                    {
                        <li class="error-item">
                            @error
                        </li>
                    }
                }

                @foreach (var group in duplicatePositions)
                {
                    var shown = group.First();
                    var hidden = group.Skip(1);

                    <li class="error-item">
                        Row @group.Key.Row, Column @group.Key.Column: showing
                        "@shown.FileName", hiding
                        @string.Join(", ", hidden.Select(s => $"\"{s.FileName}\""))
                        (same grid position resolved for multiple sheets).
                    </li>
                }
            </ul>

        </section>
    }

    @if (Model.SkippedFileNames != null &&
        Model.SkippedFileNames.Count > 0)
    {
        <section class="skipped-section">

            <h2>Skipped Files</h2>

            <ul>
                @foreach (var fileName in Model.SkippedFileNames)
                {
                    <li class="skipped-item">
                        @fileName
                    </li>
                }
            </ul>

        </section>
    }

    <a asp-controller="CadGrid"
       asp-action="Index"
       class="back-link">
        ← Back to Upload
    </a>

</div>

