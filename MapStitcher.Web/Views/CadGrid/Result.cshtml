
@model MapStitcher.Model.CadSheetGridResult
@using System.Globalization
@using System.Net

@{
    ViewData["Title"] = "CAD Sheet Grid";

    var sheetsByPosition = Model.Sheets
        .GroupBy(x => (x.Row, x.Column))
        .ToDictionary(g => g.Key, g => g.First());

    var missingByPosition = Model.MissingSlots
        .GroupBy(x => (x.Row, x.Column))
        .ToDictionary(g => g.Key, g => g.First());

    var duplicatePositions = Model.Sheets
        .GroupBy(x => (x.Row, x.Column))
        .Where(g => g.Count() > 1)
        .ToList();

    // --- Geometry Grid: sheets laid out at their real relative size/shape
    // instead of uniform boxes, using each sheet's actual CAD Width/Height. ---
    var geoRowCount = Model.RowCount;
    var geoColCount = Model.ColumnCount;

    var realWidths = Model.Sheets.Select(s => s.Width).Where(w => w > 0).ToList();
    var realHeights = Model.Sheets.Select(s => s.Height).Where(h => h > 0).ToList();
    var geoDefaultCell = Math.Max(
        realWidths.Count > 0 ? realWidths.Average() : 400.0,
        realHeights.Count > 0 ? realHeights.Average() : 400.0);

    var geoColumnWidths = new double[Math.Max(geoColCount, 1)];
    var geoRowHeights = new double[Math.Max(geoRowCount, 1)];

    for (var c = 0; c < geoColCount; c++)
    {
        var w = Model.Sheets.Where(s => s.Column == c).Select(s => s.Width).DefaultIfEmpty(0).Max();
        geoColumnWidths[c] = w > 0 ? w : geoDefaultCell;
    }

    for (var r = 0; r < geoRowCount; r++)
    {
        var h = Model.Sheets.Where(s => s.Row == r).Select(s => s.Height).DefaultIfEmpty(0).Max();
        geoRowHeights[r] = h > 0 ? h : geoDefaultCell;
    }

    const double geoGap = 25.0;

    var geoColOffsets = new double[Math.Max(geoColCount, 1)];
    for (var c = 1; c < geoColCount; c++)
        geoColOffsets[c] = geoColOffsets[c - 1] + geoColumnWidths[c - 1] + geoGap;

    var geoRowOffsets = new double[Math.Max(geoRowCount, 1)];
    for (var r = 1; r < geoRowCount; r++)
        geoRowOffsets[r] = geoRowOffsets[r - 1] + geoRowHeights[r - 1] + geoGap;

    var geoTotalWidthUnits = geoColCount > 0 ? geoColOffsets[geoColCount - 1] + geoColumnWidths[geoColCount - 1] : 0;
    var geoTotalHeightUnits = geoRowCount > 0 ? geoRowOffsets[geoRowCount - 1] + geoRowHeights[geoRowCount - 1] : 0;

    const double geoTargetPxWidth = 1200.0;
    var geoScale = geoTotalWidthUnits > 0 ? geoTargetPxWidth / geoTotalWidthUnits : 1.0;
    geoScale = Math.Max(0.02, Math.Min(geoScale, 4.0));

    var geoSvgWidth = geoTotalWidthUnits * geoScale;
    var geoSvgHeight = geoTotalHeightUnits * geoScale;

    string GeoNum(double v) => v.ToString("F2", CultureInfo.InvariantCulture);
}

<style>
    .cad-grid-page {
        padding: 24px;
    }

    .cad-grid-header {
        margin-bottom: 24px;
    }

        .cad-grid-header h1 {
            margin: 0 0 6px 0;
            font-size: 28px;
        }

        .cad-grid-header p {
            margin: 0;
            color: #666;
        }

    .summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(150px, 1fr));
        gap: 12px;
        margin-bottom: 30px;
    }

    .summary-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 16px;
        background: #fff;
    }

        .summary-card .label {
            display: block;
            font-size: 13px;
            color: #777;
            margin-bottom: 6px;
        }

        .summary-card .value {
            font-size: 24px;
            font-weight: 600;
        }

    .grid-section {
        margin-top: 20px;
    }

        .grid-section h2 {
            margin-bottom: 6px;
        }

    .grid-section-description {
        color: #666;
        margin-bottom: 16px;
    }

    .spatial-grid-wrapper {
        width: 100%;
        overflow-x: auto;
        padding-bottom: 10px;
    }

    .spatial-grid {
        display: grid;
        grid-template-columns: repeat( @Model.ColumnCount, minmax(250px, 1fr));
        gap: 12px;
        min-width: max-content;
    }

    .sheet {
        min-height: 180px;
        border: 1px solid #ccc;
        border-radius: 8px;
        background: #fff;
        padding: 16px;
        box-sizing: border-box;
    }

    .sheet-index {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .sheet-name {
        font-weight: 600;
        margin-bottom: 10px;
        word-break: break-word;
    }

    .sheet-number {
        font-size: 14px;
        margin-bottom: 8px;
    }

    .sheet-position {
        font-size: 13px;
        color: #555;
        margin-bottom: 8px;
    }

    .sheet-cad {
        font-size: 12px;
        color: #666;
        line-height: 1.5;
        margin-top: 10px;
    }

    .grid-empty {
        min-height: 180px;
        border: 2px dashed #bbb;
        border-radius: 8px;
        background: #fafafa;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        color: #999;
        box-sizing: border-box;
    }

    .grid-empty-title {
        font-size: 15px;
        font-weight: 600;
    }

    .grid-empty-position {
        margin-top: 5px;
        font-size: 11px;
        color: #aaa;
    }

    .grid-missing {
        border-color: #e0a800;
        background: #fff8e6;
        color: #8a6500;
    }

    .geometry-grid-wrapper {
        width: 100%;
        overflow: auto;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background: #f5f6f8;
    }

    .geometry-svg-sheet-rect {
        fill: #ffffff;
        stroke: #3b6fce;
        stroke-width: 1.5;
    }

    .geometry-svg-missing-rect {
        fill: #fff8e6;
        stroke: #e0a800;
        stroke-width: 1.5;
        stroke-dasharray: 6 4;
    }

    .geometry-svg-empty-rect {
        fill: #fafafa;
        stroke: #cccccc;
        stroke-width: 1;
        stroke-dasharray: 4 4;
    }

    .geometry-svg-label {
        font-size: 12px;
        font-family: sans-serif;
        fill: #222222;
    }

    .geometry-svg-sublabel {
        font-size: 10px;
        font-family: sans-serif;
        fill: #666666;
    }

    .geometry-svg-missing-label {
        font-size: 12px;
        font-family: sans-serif;
        fill: #8a6500;
    }

    .errors-section,
    .skipped-section {
        margin-top: 30px;
        padding: 16px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background: #fff;
    }

        .errors-section h2,
        .skipped-section h2 {
            margin-top: 0;
            font-size: 18px;
        }

        .errors-section ul,
        .skipped-section ul {
            margin-bottom: 0;
            padding-left: 20px;
        }

    .error-item {
        margin-bottom: 6px;
    }

    .skipped-item {
        margin-bottom: 6px;
    }

    .back-link {
        display: inline-block;
        margin-top: 24px;
        text-decoration: none;
    }

    @@media (max-width: 700px) {
        .cad-grid-page

    {
        padding: 16px;
    }

    .summary {
        grid-template-columns: 1fr;
    }

    .spatial-grid {
        grid-template-columns: repeat( @Model.ColumnCount, minmax(220px, 220px));
    }

    }</style>

<div class="cad-grid-page">

    <div class="cad-grid-header">
        <h1>CAD Sheet Grid</h1>
        <p>Spatial arrangement of uploaded CAD sheets.</p>
    </div>

    <div class="summary">

        <div class="summary-card">
            <span class="label">Sheets</span>
            <span class="value">@Model.SheetCount</span>
        </div>

        <div class="summary-card">
            <span class="label">Rows</span>
            <span class="value">@Model.RowCount</span>
        </div>

        <div class="summary-card">
            <span class="label">Columns</span>
            <span class="value">@Model.ColumnCount</span>
        </div>

    </div>

    <section class="grid-section">

        <h2>Index Grid</h2>

        <div class="grid-section-description">
            Each sheet is positioned according to its validated
            North, South, East and West relationships.
        </div>

        <div class="spatial-grid-wrapper">

            <div class="spatial-grid">

                @for (var row = 0; row < Model.RowCount; row++)
                {
                    @for (var column = 0; column < Model.ColumnCount; column++)
                    {
                        if (sheetsByPosition.TryGetValue(
                        (row, column),
                        out var sheet))
                        {
                            <div class="sheet">

                                <div class="sheet-index">
                                    Sheet #@sheet.IndexNumber
                                </div>

                                <div class="sheet-name">
                                    @sheet.FileName
                                </div>

                                <div class="sheet-number">
                                    Sheet Number:
                                    <strong>@sheet.SheetNumber</strong>
                                </div>

                                <div class="sheet-position">
                                    Row: @sheet.Row
                                    <br />
                                    Column: @sheet.Column
                                </div>

                                <div class="sheet-cad">
                                    <strong>CAD Bounds</strong>
                                    <br />
                                    X:
                                    @sheet.MinX.ToString("F2")
                                    –
                                    @sheet.MaxX.ToString("F2")
                                    <br />
                                    Y:
                                    @sheet.MinY.ToString("F2")
                                    –
                                    @sheet.MaxY.ToString("F2")
                                    <br />
                                    Width:
                                    @sheet.Width.ToString("F2")
                                    <br />
                                    Height:
                                    @sheet.Height.ToString("F2")
                                    <br />
                                    Entities:
                                    @sheet.EntityCount
                                    <br />
                                    Laghu References:
                                    @sheet.LaghuReferenceCount
                                </div>

                            </div>
                        }
                        else if (missingByPosition.TryGetValue(
                        (row, column),
                        out var missing))
                        {
                            <div class="grid-empty grid-missing">

                                <div class="grid-empty-title">
                                    Missing
                                </div>

                                <div class="grid-empty-position">
                                    Sheet @missing.SheetNumber not uploaded
                                    <br />
                                    Row @row · Column @column
                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="grid-empty">

                                <div class="grid-empty-title">
                                    Empty
                                </div>

                                <div class="grid-empty-position">
                                    Row @row · Column @column
                                </div>

                            </div>
                        }
                    }
                }

            </div>

        </div>

    </section>

    <section class="grid-section">

        <h2>Geometry Grid</h2>

        <div class="grid-section-description">
            Same row/column arrangement as above, but each sheet is drawn at
            its real relative width and height instead of a uniform box.
        </div>

        <div class="geometry-grid-wrapper">
            <svg width="@GeoNum(geoSvgWidth)"
                 height="@GeoNum(geoSvgHeight)"
                 viewBox="0 0 @GeoNum(geoSvgWidth) @GeoNum(geoSvgHeight)"
                 xmlns="http://www.w3.org/2000/svg">

                @for (var row = 0; row < geoRowCount; row++)
                {
                    @for (var column = 0; column < geoColCount; column++)
                    {
                        var cellX = geoColOffsets[column] * geoScale;
                        var cellY = geoRowOffsets[row] * geoScale;
                        var cellW = geoColumnWidths[column] * geoScale;
                        var cellH = geoRowHeights[row] * geoScale;

                        if (sheetsByPosition.TryGetValue((row, column), out var geoSheet))
                        {
                            // CAD Y-axis is up; SVG Y-axis is down. Flip Y relative to sheet's MinY.
                            // All polygon points are translated so MinX/MinY maps to cell top-left.
                            var originX = cellX + (cellW - geoSheet.Width * geoScale) / 2;
                            var originY = cellY + (cellH - geoSheet.Height * geoScale) / 2;
                            var sheetMinX = geoSheet.MinX;
                            var sheetMaxY = geoSheet.MaxY;

                            var hasPolygons = geoSheet.BoundaryPolygons != null && geoSheet.BoundaryPolygons.Count > 0;

                            if (hasPolygons)
                            {
                                // Cell background
                                @Html.Raw($"<rect class=\"geometry-svg-sheet-rect\" x=\"{GeoNum(originX)}\" y=\"{GeoNum(originY)}\" width=\"{GeoNum(geoSheet.Width * geoScale)}\" height=\"{GeoNum(geoSheet.Height * geoScale)}\" fill=\"#f8f9ff\" stroke=\"#ccc\" stroke-width=\"0.5\" />")

                                foreach (var ring in geoSheet.BoundaryPolygons)
                                {
                                    if (ring.Count < 3) continue;

                                    var pointsStr = string.Join(" ", ring.Select(p =>
                                    {
                                        var px = originX + (p.X - sheetMinX) * geoScale;
                                        var py = originY + (sheetMaxY - p.Y) * geoScale;
                                        return $"{GeoNum(px)},{GeoNum(py)}";
                                    }));

                                    @Html.Raw($"<polygon points=\"{pointsStr}\" fill=\"#ddeeff\" fill-opacity=\"0.5\" stroke=\"#3b6fce\" stroke-width=\"1.5\" stroke-linejoin=\"round\" />")
                                }
                            }
                            else
                            {
                                // No polygon data — fall back to bounding box rectangle
                                <rect class="geometry-svg-sheet-rect"
                                      x="@GeoNum(originX)" y="@GeoNum(originY)"
                                      width="@GeoNum(geoSheet.Width * geoScale)" height="@GeoNum(geoSheet.Height * geoScale)" />
                            }

                            @Html.Raw($"<text class=\"geometry-svg-label\" x=\"{GeoNum(originX + 6)}\" y=\"{GeoNum(originY + 16)}\">{WebUtility.HtmlEncode("Sheet " + geoSheet.SheetNumber)}</text>")
                            @Html.Raw($"<text class=\"geometry-svg-sublabel\" x=\"{GeoNum(originX + 6)}\" y=\"{GeoNum(originY + 30)}\">{WebUtility.HtmlEncode(geoSheet.Width.ToString("F0") + " x " + geoSheet.Height.ToString("F0"))}</text>")
                        }
                        else if (missingByPosition.TryGetValue((row, column), out var geoMissing))
                        {
                            <rect class="geometry-svg-missing-rect"
                                  x="@GeoNum(cellX)" y="@GeoNum(cellY)"
                                  width="@GeoNum(cellW)" height="@GeoNum(cellH)" />

                            @Html.Raw($"<text class=\"geometry-svg-missing-label\" x=\"{GeoNum(cellX + 6)}\" y=\"{GeoNum(cellY + 16)}\">{WebUtility.HtmlEncode("Sheet " + geoMissing.SheetNumber + " not uploaded")}</text>")
                        }
                        else
                        {
                            <rect class="geometry-svg-empty-rect"
                                  x="@GeoNum(cellX)" y="@GeoNum(cellY)"
                                  width="@GeoNum(cellW)" height="@GeoNum(cellH)" />
                        }
                    }
                }

            </svg>
        </div>

    </section>

    @if (!string.IsNullOrWhiteSpace(Model.MergeOutputFileName))
    {
        <section class="errors-section" style="border-color:#3b6fce; background:#f0f4ff;">
            <h2 style="color:#3b6fce;">⬇ Export Geometry Grid</h2>
            <p style="margin:0 0 12px 0; color:#555;">Full geometry of all placed sheets tiled in the same grid layout shown above.</p>
            <a asp-controller="CadGrid"
               asp-action="DownloadMerged"
               asp-route-fileName="@Model.MergeOutputFileName"
               style="display:inline-block;padding:10px 22px;background:#3b6fce;color:#fff;border-radius:6px;text-decoration:none;font-weight:600;">
                ⬇ Download Geometry Grid DXF
            </a>
        </section>
    }
    else
    {
        <section class="errors-section" style="border-color:#ccc; background:#fafafa;">
            <h2 style="color:#999;">Export Geometry Grid</h2>
            <p style="margin:0; color:#aaa;">DXF export was not generated. Re-upload the files to trigger export.</p>
        </section>
    }

    @if ((Model.MergeErrors != null && Model.MergeErrors.Count > 0) ||
        duplicatePositions.Count > 0)
    {
        <section class="errors-section">

            <h2>Topology / Processing Messages</h2>

            <ul>
                @if (Model.MergeErrors != null)
                {
                    @foreach (var error in Model.MergeErrors)
                    {
                        <li class="error-item">
                            @error
                        </li>
                    }
                }

                @foreach (var group in duplicatePositions)
                {
                    var shown = group.First();
                    var hidden = group.Skip(1);

                    <li class="error-item">
                        Row @group.Key.Row, Column @group.Key.Column: showing
                        "@shown.FileName", hiding
                        @string.Join(", ", hidden.Select(s => $"\"{s.FileName}\""))
                        (same grid position resolved for multiple sheets).
                    </li>
                }
            </ul>

        </section>
    }

    @if (Model.SkippedFileNames != null &&
        Model.SkippedFileNames.Count > 0)
    {
        <section class="skipped-section">

            <h2>Skipped Files</h2>

            <ul>
                @foreach (var fileName in Model.SkippedFileNames)
                {
                    <li class="skipped-item">
                        @fileName
                    </li>
                }
            </ul>

        </section>
    }

    <a asp-controller="CadGrid"
       asp-action="Index"
       class="back-link">
        ← Back to Upload
    </a>

</div>

