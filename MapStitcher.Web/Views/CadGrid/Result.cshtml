@model MapStitcher.Model.CadSheetGridResult
@using System.Globalization
@using System.Net
@{
    ViewData["Title"] = "CAD Sheet Grid — Result";
    Layout = null;

    var sheetsByPosition = Model.Sheets
        .GroupBy(x => (x.Row, x.Column))
        .ToDictionary(g => g.Key, g => g.First());

    var missingByPosition = Model.MissingSlots
        .GroupBy(x => (x.Row, x.Column))
        .ToDictionary(g => g.Key, g => g.First());

    var duplicatePositions = Model.Sheets
        .GroupBy(x => (x.Row, x.Column))
        .Where(g => g.Count() > 1)
        .ToList();

    int gridRows = Math.Max(Model.RowCount, 1);
    int gridCols = Math.Max(Model.ColumnCount, 1);

    var statusColor = new Dictionary<string, string>
    {
        ["Filled"] = "#22c55e",
        ["Missing"] = "#f59e0b",
        ["Empty"] = "#334155"
    };

    // --- Geometry Grid: sheets laid out at real relative size/shape ---
    var geoRowCount = Model.RowCount;
    var geoColCount = Model.ColumnCount;

    var realWidths = Model.Sheets.Select(s => s.Width).Where(w => w > 0).ToList();
    var realHeights = Model.Sheets.Select(s => s.Height).Where(h => h > 0).ToList();
    var geoDefaultCell = Math.Max(
        realWidths.Count > 0 ? realWidths.Average() : 400.0,
        realHeights.Count > 0 ? realHeights.Average() : 400.0);

    var geoColumnWidths = new double[Math.Max(geoColCount, 1)];
    var geoRowHeights = new double[Math.Max(geoRowCount, 1)];

    for (var c = 0; c < geoColCount; c++)
    {
        var w = Model.Sheets.Where(s => s.Column == c).Select(s => s.Width).DefaultIfEmpty(0).Max();
        geoColumnWidths[c] = w > 0 ? w : geoDefaultCell;
    }

    for (var r = 0; r < geoRowCount; r++)
    {
        var h = Model.Sheets.Where(s => s.Row == r).Select(s => s.Height).DefaultIfEmpty(0).Max();
        geoRowHeights[r] = h > 0 ? h : geoDefaultCell;
    }

    const double geoGap = 25.0;

    var geoColOffsets = new double[Math.Max(geoColCount, 1)];
    for (var c = 1; c < geoColCount; c++)
        geoColOffsets[c] = geoColOffsets[c - 1] + geoColumnWidths[c - 1] + geoGap;

    var geoRowOffsets = new double[Math.Max(geoRowCount, 1)];
    for (var r = 1; r < geoRowCount; r++)
        geoRowOffsets[r] = geoRowOffsets[r - 1] + geoRowHeights[r - 1] + geoGap;

    var geoTotalWidthUnits = geoColCount > 0 ? geoColOffsets[geoColCount - 1] + geoColumnWidths[geoColCount - 1] : 0;
    var geoTotalHeightUnits = geoRowCount > 0 ? geoRowOffsets[geoRowCount - 1] + geoRowHeights[geoRowCount - 1] : 0;

    const double geoTargetPxWidth = 1200.0;
    var geoScale = geoTotalWidthUnits > 0 ? geoTargetPxWidth / geoTotalWidthUnits : 1.0;
    geoScale = Math.Max(0.02, Math.Min(geoScale, 4.0));

    var geoSvgWidth = geoTotalWidthUnits * geoScale;
    var geoSvgHeight = geoTotalHeightUnits * geoScale;

    string GeoNum(double v) => v.ToString("F2", CultureInfo.InvariantCulture);
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CAD Sheet Grid — Result</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/workspace.css" rel="stylesheet" />
    <style>
        :root { --grid-cols: @gridCols; --grid-rows: @gridRows; }
        .grid-cell.missing { background:#241a08; border:2px dashed #b45309; color:#f59e0b; }
        .grid-cell .sheet-file { font-size:9px; color:#94a3b8; margin-top:2px; max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

        .geometry-grid-wrapper { padding:20px; background:#0b1220; }
        .geometry-grid-wrapper svg { background:#0f172a; border:1px solid #334155; border-radius:6px; }
        .geometry-svg-sheet-rect { fill:#1e293b; stroke:#475569; stroke-width:1; }
        .geometry-svg-missing-rect { fill:#241a08; stroke:#b45309; stroke-width:1.5; stroke-dasharray:6,4; }
        .geometry-svg-empty-rect { fill:#0b1220; stroke:#1e293b; stroke-width:1; stroke-dasharray:3,3; }
        .geometry-svg-label { fill:#e2e8f0; font-size:12px; font-family:inherit; font-weight:600; }
        .geometry-svg-sublabel { fill:#94a3b8; font-size:10px; font-family:inherit; }
        .geometry-svg-missing-label { fill:#f59e0b; font-size:11px; font-family:inherit; }

        #geometry-view { display:none; }
    </style>
</head>
<body>

    <div class="top-bar">
        <div class="project-heading">
            <div class="project-name">CAD Sheet Grid</div>
            <div class="jurisdiction">
                <span>@Model.SheetCount sheets</span>
                <span class="separator">›</span>
                <span>@gridRows × @gridCols grid</span>
            </div>
        </div>

        <div class="top-actions">
            @if (!string.IsNullOrWhiteSpace(Model.SessionId))
            {
                <a asp-controller="CadGrid" asp-action="ExportGeometryGrid" asp-route-sessionId="@Model.SessionId"
                   class="btn btn-sm btn-outline-success">↓ Export DXF</a>
                <a asp-controller="CadGrid" asp-action="ExportGeometryGridDwg" asp-route-sessionId="@Model.SessionId"
                   class="btn btn-sm btn-outline-success">↓ Export DWG</a>
                <a asp-controller="CadGrid" asp-action="ExportVillageStitchedMap" asp-route-sessionId="@Model.SessionId"
                   class="btn btn-sm btn-primary">⚡ Stitch Village Map</a>
            }
            <a asp-controller="CadGrid" asp-action="Index" class="btn btn-sm btn-outline-secondary">← Back to Upload</a>
        </div>
    </div>

    @if (Model.MergeErrors != null && Model.MergeErrors.Count > 0)
    {
        <div class="alert-bar">
            <div class="alert alert-warning alert-dismissible mb-0 py-2" role="alert">
                @string.Join("; ", Model.MergeErrors.TakeLast(5))
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <div class="workspace-layout">

        <aside class="sidebar">
            <div class="sidebar-header">Sheets (@Model.Sheets.Count)</div>
            <div class="sidebar-sheet-list">
                @foreach (var sheet in Model.Sheets.OrderBy(s => s.Row).ThenBy(s => s.Column))
                {
                    <div class="sidebar-sheet placed">
                        <div class="sheet-num">Sheet @sheet.SheetNumber</div>
                        <div class="sheet-status" style="color:#22c55e;">
                            ● Row @sheet.Row, Col @sheet.Column
                        </div>
                    </div>
                }

                @foreach (var missing in Model.MissingSlots)
                {
                    <div class="sidebar-sheet unplaced">
                        <div class="sheet-num">Sheet @missing.SheetNumber</div>
                        <div class="sheet-status" style="color:#f59e0b;">
                            ● Missing (Row @missing.Row, Col @missing.Column)
                        </div>
                    </div>
                }

                @if (Model.SkippedFileNames != null && Model.SkippedFileNames.Count > 0)
                {
                    <div class="sidebar-header" style="margin-top:8px;">Skipped Files</div>
                    @foreach (var fileName in Model.SkippedFileNames)
                    {
                        <div class="sidebar-sheet unplaced">
                            <div class="sheet-num" style="font-size:11px;">@fileName</div>
                        </div>
                    }
                }
            </div>

            <div class="legend">
                <div class="legend-title">Legend</div>
                <div class="legend-item"><div class="legend-dot" style="background:#22c55e"></div>Filled</div>
                <div class="legend-item"><div class="legend-dot" style="background:#f59e0b"></div>Missing</div>
                <div class="legend-item"><div class="legend-dot" style="background:#334155"></div>Empty</div>
            </div>
        </aside>

        <div class="canvas-area">

            <div class="canvas-toolbar">
                <div class="view-toggle">
                    <button type="button" id="btn-placement" class="active" onclick="showView('placement')">Placement Grid</button>
                    <button type="button" id="btn-geometry" onclick="showView('geometry')">Geometry Grid</button>
                </div>
                <div class="toolbar-info">@Model.RowCount rows × @Model.ColumnCount cols</div>
            </div>

            <div class="canvas-scroll" style="overflow:auto;">
                <div id="grid-view">
                    @for (var row = 0; row < gridRows; row++)
                    {
                        for (var column = 0; column < gridCols; column++)
                        {
                            if (sheetsByPosition.TryGetValue((row, column), out var sheet))
                            {
                                <div class="grid-cell filled" title="Sheet @sheet.SheetNumber">
                                    <div class="cell-coord">@row,@column</div>
                                    <div class="cell-label">@sheet.SheetNumber</div>
                                    <div class="cell-status-dot" style="background:#22c55e"></div>
                                    <div class="sheet-file">@sheet.FileName</div>
                                </div>
                            }
                            else if (missingByPosition.TryGetValue((row, column), out var missing))
                            {
                                <div class="grid-cell missing" title="Sheet @missing.SheetNumber not uploaded">
                                    <div class="cell-coord">@row,@column</div>
                                    <div class="empty-label">Missing</div>
                                    <div class="sheet-file">Sheet @missing.SheetNumber</div>
                                </div>
                            }
                            else
                            {
                                <div class="grid-cell empty">
                                    <div class="cell-coord">@row,@column</div>
                                    <div class="empty-plus">+</div>
                                    <div class="empty-label">Empty</div>
                                </div>
                            }
                        }
                    }
                </div>

                @if (duplicatePositions.Count > 0)
                {
                    <div style="padding:0 20px 20px; color:#f59e0b; font-size:12px;">
                        @foreach (var group in duplicatePositions)
                        {
                            var shown = group.First();
                            var hidden = group.Skip(1);
                            <div>
                                Row @group.Key.Row, Column @group.Key.Column: showing "@shown.FileName",
                                hiding @string.Join(", ", hidden.Select(s => $"\"{s.FileName}\""))
                            </div>
                        }
                    </div>
                }

                <div id="geometry-view" class="geometry-grid-wrapper">
                    <svg width="@GeoNum(geoSvgWidth)"
                         height="@GeoNum(geoSvgHeight)"
                         viewBox="0 0 @GeoNum(geoSvgWidth) @GeoNum(geoSvgHeight)"
                         xmlns="http://www.w3.org/2000/svg">

                        @for (var row = 0; row < geoRowCount; row++)
                        {
                            @for (var column = 0; column < geoColCount; column++)
                            {
                                var cellX = geoColOffsets[column] * geoScale;
                                var cellY = geoRowOffsets[row] * geoScale;
                                var cellW = geoColumnWidths[column] * geoScale;
                                var cellH = geoRowHeights[row] * geoScale;

                                if (sheetsByPosition.TryGetValue((row, column), out var geoSheet))
                                {
                                    var originX = cellX + (cellW - geoSheet.Width * geoScale) / 2;
                                    var originY = cellY + (cellH - geoSheet.Height * geoScale) / 2;
                                    var sheetMinX = geoSheet.MinX;
                                    var sheetMaxY = geoSheet.MaxY;

                                    var hasPolygons = geoSheet.BoundaryPolygons != null && geoSheet.BoundaryPolygons.Count > 0;

                                    if (hasPolygons)
                                    {
                                        @Html.Raw($"<rect class=\"geometry-svg-sheet-rect\" x=\"{GeoNum(originX)}\" y=\"{GeoNum(originY)}\" width=\"{GeoNum(geoSheet.Width * geoScale)}\" height=\"{GeoNum(geoSheet.Height * geoScale)}\" />")

                                        foreach (var ring in geoSheet.BoundaryPolygons)
                                        {
                                            if (ring.Count < 3) continue;

                                            var pointsStr = string.Join(" ", ring.Select(p =>
                                            {
                                                var px = originX + (p.X - sheetMinX) * geoScale;
                                                var py = originY + (sheetMaxY - p.Y) * geoScale;
                                                return $"{GeoNum(px)},{GeoNum(py)}";
                                            }));

                                            @Html.Raw($"<polygon points=\"{pointsStr}\" fill=\"#3b6fce\" fill-opacity=\"0.25\" stroke=\"#60a5fa\" stroke-width=\"1.5\" stroke-linejoin=\"round\" />")
                                        }
                                    }
                                    else
                                    {
                                        <rect class="geometry-svg-sheet-rect"
                                              x="@GeoNum(originX)" y="@GeoNum(originY)"
                                              width="@GeoNum(geoSheet.Width * geoScale)" height="@GeoNum(geoSheet.Height * geoScale)" />
                                    }

                                    @Html.Raw($"<text class=\"geometry-svg-label\" x=\"{GeoNum(originX + 6)}\" y=\"{GeoNum(originY + 16)}\">{WebUtility.HtmlEncode("Sheet " + geoSheet.SheetNumber)}</text>")
                                    @Html.Raw($"<text class=\"geometry-svg-sublabel\" x=\"{GeoNum(originX + 6)}\" y=\"{GeoNum(originY + 30)}\">{WebUtility.HtmlEncode(geoSheet.Width.ToString("F0") + " x " + geoSheet.Height.ToString("F0"))}</text>")
                                }
                                else if (missingByPosition.TryGetValue((row, column), out var geoMissing))
                                {
                                    <rect class="geometry-svg-missing-rect"
                                          x="@GeoNum(cellX)" y="@GeoNum(cellY)"
                                          width="@GeoNum(cellW)" height="@GeoNum(cellH)" />

                                    @Html.Raw($"<text class=\"geometry-svg-missing-label\" x=\"{GeoNum(cellX + 6)}\" y=\"{GeoNum(cellY + 16)}\">{WebUtility.HtmlEncode("Sheet " + geoMissing.SheetNumber + " not uploaded")}</text>")
                                }
                                else
                                {
                                    <rect class="geometry-svg-empty-rect"
                                          x="@GeoNum(cellX)" y="@GeoNum(cellY)"
                                          width="@GeoNum(cellW)" height="@GeoNum(cellH)" />
                                }
                            }
                        }

                    </svg>
                </div>
            </div>

        </div>

    </div>

    <script>
        function showView(mode) {
            document.getElementById('grid-view').style.display = mode === 'placement' ? 'grid' : 'none';
            document.getElementById('geometry-view').style.display = mode === 'geometry' ? 'block' : 'none';
            document.getElementById('btn-placement').classList.toggle('active', mode === 'placement');
            document.getElementById('btn-geometry').classList.toggle('active', mode === 'geometry');
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
