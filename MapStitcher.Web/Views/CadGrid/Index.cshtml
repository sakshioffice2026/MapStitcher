@{
    ViewData["Title"] = "CAD Sheet Grid";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CAD Sheet Grid — Upload</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/workspace.css" rel="stylesheet" />
</head>
<body>

    <div class="top-bar">
        <div class="project-heading">
            <div class="project-name">CAD Sheet Grid</div>
            <div class="jurisdiction"><span>Upload</span></div>
        </div>
        <div class="top-actions"></div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert-bar">
            <div class="alert alert-danger alert-dismissible mb-0 py-2" role="alert">
                @ViewBag.Error
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <div class="workspace-layout">

        <aside class="sidebar">
            <div class="sidebar-header">How it works</div>
            <div class="sidebar-sheet-list" style="padding:14px; font-size:12px; color:#94a3b8; line-height:1.6;">
                <ul style="padding-left:16px; margin:0;">
                    <li>Sheet index is extracted dynamically.</li>
                    <li>CAD X/Y coordinates are extracted.</li>
                    <li>Laghu references are extracted.</li>
                    <li>Grid rows/columns are calculated automatically.</li>
                    <li>No hard-coded sheet limit.</li>
                </ul>
            </div>
        </aside>

        <div class="canvas-area">
            <div class="canvas-toolbar">
                <div class="toolbar-info">Select DWG / DXF files to build the grid</div>
            </div>

            <div class="canvas-scroll" style="display:flex; align-items:center; justify-content:center;">
                <div style="width:420px; max-width:90%; background:#111827; border:1px solid #334155; border-radius:8px; padding:24px;">

                    <form method="post" action="/CadGrid/Index" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <label style="font-size:12px; color:#94a3b8; text-transform:uppercase; letter-spacing:1px;">
                            Select DWG / DXF files
                        </label>

                        <input type="file"
                               name="files"
                               accept=".dwg,.dxf"
                               multiple
                               required
                               class="form-control form-control-sm bg-dark text-light border-secondary mt-2 mb-3" />

                        <button type="submit" class="btn btn-sm btn-primary w-100">
                            ⚡ Build Grid
                        </button>
                    </form>

                </div>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
